{% extends 'base.html.twig' %}
{% block title %}Sale Details{% endblock %}

{% block body %}

<div class="mb-5">
  <h1 class="fw-semibold">Sale #{{ sale.id }}</h1>
  <p class="text-muted">Detailed information</p>
</div>

<div class="card border-0 shadow-lg rounded-4">
  <div class="card-body p-5">

    <div class="row mb-4">
      <div class="col-md-4 text-muted">Quantity</div>
      <div class="col-md-8 fw-semibold">{{ sale.quantity }}</div>
    </div>

    <div class="row">
      <div class="col-md-4 text-muted">Sold at</div>
      <div class="col-md-8">{{ sale.soldAt|date('d M Y · H:i') }}</div>
    </div>

  </div>

  <div class="card-footer bg-white border-0 px-5 py-4 d-flex justify-content-between">
    <a href="{{ path('app_sales_index') }}" class="btn btn-light">
      Back
    </a>

    <div>
      <a href="{{ path('app_sales_edit', {'id': sale.id}) }}"
         class="btn btn-outline-primary me-2">
        Edit
      </a>

      {{ include('sales/_delete_form.html.twig', {sale: sale}) }}
    </div>
  </div>
</div>

{% endblock %}
