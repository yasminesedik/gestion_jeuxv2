{% extends 'base.html.twig' %}
{% block title %}Sales{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-5">
  <div>
    <h1 class="fw-semibold mb-1">Sales</h1>
    <p class="text-muted mb-0">Manage and track all store sales</p>
  </div>

  <a href="{{ path('app_sales_new') }}" class="btn btn-dark px-4 py-2 shadow-sm">
    + New Sale
  </a>
</div>

<div class="card border-0 shadow-lg rounded-4">
  <div class="card-body p-4">

    <table class="table align-middle">
      <thead class="border-bottom text-muted small">
        <tr>
          <th>ID</th>
          <th>Quantity</th>
          <th>Sold at</th>
          <th>Client</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
      {% for sale in sales %}
        <tr class="border-bottom">
          <td class="fw-semibold">#{{ sale.id }}</td>

          <td>
            <span class="badge bg-secondary bg-opacity-10 text-dark px-3 py-2 rounded-pill">
              {{ sale.quantity }}
            </span>
          </td>

          <td class="text-muted">
            {{ sale.soldAt|date('d M Y · H:i') }}
          </td>
          <td>
  {{ sale.client is not null ? sale.client.fullName : '—' }}
</td>


          <td class="text-end">
            <a href="{{ path('app_sales_show', {'id': sale.id}) }}"
               class="btn btn-sm btn-light border me-1">
              View
            </a>

            <a href="{{ path('app_sales_edit', {'id': sale.id}) }}"
               class="btn btn-sm btn-outline-primary me-1">
              Edit
            </a>

            {{ include('sales/_delete_form.html.twig', {sale: sale}) }}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" class="text-center text-muted py-5">
            No sales recorded yet
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

  </div>
</div>

{% endblock %}
