{% extends 'base.html.twig' %}
{% block title %}Category{% endblock %}

{% block body %}

<div class="mb-5">
  <h1 class="fw-semibold">{{ category.name }}</h1>
  <p class="text-muted">Category details</p>
</div>

<div class="card border-0 shadow-lg rounded-4">
  <div class="card-body p-5">

    <div class="row mb-4">
      <div class="col-md-4 text-muted">Name</div>
      <div class="col-md-8 fw-semibold">{{ category.name }}</div>
    </div>

  </div>

  <div class="card-footer bg-white border-0 px-5 py-4 d-flex justify-content-between">
    <a href="{{ path('app_category_index') }}" class="btn btn-light">
      Back
    </a>

    <div>
      <a href="{{ path('app_category_edit', {'id': category.id}) }}"
         class="btn btn-outline-primary me-2">
        Edit
      </a>

      {{ include('category/_delete_form.html.twig', {category: category}) }}
    </div>
  </div>
</div>

{% endblock %}
