{% extends 'base.html.twig' %}
{% block title %}Categories{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-5">
  <div>
    <h1 class="fw-semibold mb-1">Categories</h1>
    <p class="text-muted mb-0">Manage game categories</p>
  </div>

  <a href="{{ path('app_category_new') }}"
     class="btn btn-dark px-4 py-2 shadow-sm">
    + New Category
  </a>
</div>

<div class="card border-0 shadow-lg rounded-4">
  <div class="card-body p-4">

    <table class="table align-middle">
      <thead class="border-bottom text-muted small">
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
      {% for category in categories %}
        <tr class="border-bottom">
          <td class="fw-semibold">#{{ category.id }}</td>

          <td class="fw-semibold">{{ category.name }}</td>

          <td class="text-end">
            <a href="{{ path('app_category_show', {'id': category.id}) }}"
               class="btn btn-sm btn-light border me-1">
              View
            </a>

            <a href="{{ path('app_category_edit', {'id': category.id}) }}"
               class="btn btn-sm btn-outline-primary me-1">
              Edit
            </a>

            {{ include('category/_delete_form.html.twig', {category: category}) }}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="3" class="text-center text-muted py-5">
            No categories found
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

  </div>
</div>

{% endblock %}
