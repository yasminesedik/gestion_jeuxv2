{% extends 'base.html.twig' %}
{% block title %}Game Details{% endblock %}

{% block body %}

<div class="mb-5">
  <h1 class="fw-semibold">{{ game.title }}</h1>
  <p class="text-muted">Game details</p>
</div>

<div class="card border-0 shadow-lg rounded-4">
  <div class="card-body p-5">

    <div class="row mb-4">
      <div class="col-md-4 text-muted">Price</div>
      <div class="col-md-8 fw-semibold">{{ game.price }} $</div>
    </div>

    <div class="row mb-4">
      <div class="col-md-4 text-muted">Stock</div>
      <div class="col-md-8">{{ game.stock }}</div>
    </div>

    <div class="row mb-4">
      <div class="col-md-4 text-muted">Release date</div>
      <div class="col-md-8">
        {{ game.releaseDate ? game.releaseDate|date('d M Y') : '—' }}
      </div>
    </div>

  </div>

  <div class="card-footer bg-white border-0 px-5 py-4 d-flex justify-content-between">
    <a href="{{ path('app_game_index') }}" class="btn btn-light">
      Back
    </a>

    <div>
      <a href="{{ path('app_game_edit', {'id': game.id}) }}"
         class="btn btn-outline-primary me-2">
        Edit
      </a>

      {{ include('game/_delete_form.html.twig', {game: game}) }}
    </div>
  </div>
</div>

{% endblock %}
