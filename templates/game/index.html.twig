{% extends 'base.html.twig' %}
{% block title %}Games{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-5">
  <div>
    <h1 class="fw-semibold mb-1">Games</h1>
    <p class="text-muted mb-0">Manage your game catalog</p>
  </div>

  <a href="{{ path('app_game_new') }}" class="btn btn-dark px-4 py-2 shadow-sm">
    + New Game
  </a>
</div>

<div class="card border-0 shadow-lg rounded-4">
  <div class="card-body p-4">

    <table class="table align-middle">
      <thead class="border-bottom text-muted small">
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Release</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
      {% for game in games %}
        <tr class="border-bottom">
          <td class="fw-semibold">#{{ game.id }}</td>

          <td class="fw-semibold">{{ game.title }}</td>

          <td class="text-muted">
            {{ game.price }} $
          </td>

          <td>
            <span class="badge bg-secondary bg-opacity-10 text-dark px-3 py-2 rounded-pill">
              {{ game.stock }}
            </span>
          </td>

          <td class="text-muted">
            {{ game.releaseDate ? game.releaseDate|date('d M Y') : '—' }}
          </td>

          <td class="text-end">
            <a href="{{ path('app_game_show', {'id': game.id}) }}"
               class="btn btn-sm btn-light border me-1">
              View
            </a>

            <a href="{{ path('app_game_edit', {'id': game.id}) }}"
               class="btn btn-sm btn-outline-primary me-1">
              Edit
            </a>

            {{ include('game/_delete_form.html.twig', {game: game}) }}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" class="text-center text-muted py-5">
            No games found
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

  </div>
</div>

{% endblock %}
