<form method="post"
      action="{{ path('app_game_delete', {'id': game.id}) }}"
      class="d-inline"
      onsubmit="return confirm('Delete this game?');">

  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">

  <button class="btn btn-outline-danger btn-sm px-3">
    Delete
  </button>
</form>
