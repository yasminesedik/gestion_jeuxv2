{{ form_start(form) }}

<div class="card border-0 shadow-lg rounded-4">
  <div class="card-body p-5">
    <div class="mb-4">
      <label class="form-label text-muted">Full Name</label>
      {{ form_widget(form.fullName, {'attr': {'class': 'form-control form-control-lg'}}) }}
      {{ form_errors(form.fullName) }}
    </div>

    <div class="mb-4">
      <label class="form-label text-muted">Email</label>
      {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-lg'}}) }}
      {{ form_errors(form.email) }}
    </div>

    <div class="mb-4">
      <label class="form-label text-muted">Phone</label>
      {{ form_widget(form.phone, {'attr': {'class': 'form-control form-control-lg'}}) }}
      {{ form_errors(form.phone) }}
    </div>
  </div>

  <div class="card-footer bg-white border-0 px-5 py-4 d-flex justify-content-between">
    <a href="{{ path('app_client_index') }}" class="btn btn-light px-4">
      Cancel
    </a>
    <button class="btn btn-dark px-5">
      {{ button_label|default('Save Client') }}
    </button>
  </div>
</div>

{{ form_end(form) }}
